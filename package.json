{
  "name": "agentwatch",
  "version": "0.4.0",
  "description": "Live terminal view of Claude Code sessions and subagents, built on Claude Code hooks, with signed messages to a session's main agent",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "bin": {
    "agentwatch": "bin/agentwatch.mjs"
  },
  "files": [
    "bin",
    "dist",
    "native"
  ],
  "scripts": {
    "dev": "tsx src/cli/main.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings . && eslint --max-warnings 0 .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
